{
  "name": "lovelace-metron",
  "version": "0.3.0",
  "description": "Metron: a set of Home Assistant Lovelace cards for home energy, gas, solar and weather data.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Igor Ognichenko",
  "homepage": "https://github.com/RobinCK/lovelace-metron#readme",
  "repository": {
